{
  "name": "electron-ipc-module",
  "version": "0.3.0",
  "description": "Modular, type-safe Electron IPC with auto-generated preload bridges",
  "keywords": [
    "context-bridge",
    "electron",
    "ipc",
    "main-process",
    "preload",
    "rollup",
    "typescript"
  ],
  "homepage": "https://github.com/antelm-dev/electron-ipc-module#readme",
  "bugs": "https://github.com/antelm-dev/electron-ipc-module/issues",
  "license": "MIT",
  "author": "Adel Terki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antelm-dev/electron-ipc-module.git"
  },
  "bin": {
    "electron-ipc-module": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rollup-plugin": {
      "types": "./dist/rollup-plugin.d.ts",
      "import": "./dist/rollup-plugin.js"
    },
    "./generator": {
      "types": "./dist/bridge/ipc-bridge.d.ts",
      "import": "./dist/bridge/ipc-bridge.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "prepare": "tsc --build",
    "typecheck": "tsc -p tsconfig.vitest.json --noEmit",
    "test:api": "pnpm run build && tsc -p tsconfig.public-api.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:commits": "commitlint --from HEAD~1 --to HEAD",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test:api && pnpm run test",
    "prepack": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.72.0",
    "rollup": "^4.17.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "electron": ">=12.0.0",
    "typescript": ">=5.0.0 <7"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "packageManager": "pnpm@9.15.9"
}
